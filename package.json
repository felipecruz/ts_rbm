{
  "name": "ts_rbm",
  "version": "0.0.1",
  "description": "An interactive essay about generative models, built around a TypeScript restricted Boltzmann machine",
  "main": "run.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/build-math.mjs",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "test": "node --test scripts/test.mjs scripts/test-math.mjs scripts/test-i18n.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felipecruz/ts_rbm.git"
  },
  "keywords": [
    "machine-learning",
    "rbm",
    "typescript"
  ],
  "author": "Felipe Cruz",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/felipecruz/ts_rbm/issues"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "katex": "0.18.0"
  }
}
